# ---------------------------------------------------------------------------
# ARCHIT.AI environment
# Copy to `.env.local` for local dev. Every value below is OPTIONAL — the site
# renders and the chat falls back to a deterministic local responder when the
# keys are absent, so nothing hard-fails in a fresh clone.
# ---------------------------------------------------------------------------

# --- OpenRouter (powers the "Ask Archit" clone, FREE models only) -----------
# Server-only. Without it the chat answers from the pre-written responder.
OPENROUTER_API_KEY=
# Optional: comma-separated preference order. Only IDs ending in ":free" are
# accepted; anything else is ignored, so this cannot enable a paid model. Each
# is also checked against OpenRouter's live catalogue for zero pricing.
OPENROUTER_MODELS=

# --- Supabase (chat persistence + analytics) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# --- Voice (read-aloud in the chat, free OpenRouter TTS) ---------------------
# Uses OPENROUTER_API_KEY above; there is no separate voice key. The model is
# picked from OpenRouter's live list of free TTS models. With no key, or no free
# model answering, Listen uses the browser's own voice instead. Visit
# /api/speak to test the setup.
# Optional: a Flux voice to put first. Default flux-drew-en, with
# flux-bruce-en and flux-jack-en as fallbacks: Deepgram's featured male voices.
# flux-rufus-en is the other featured male voice (British).
OPENROUTER_TTS_VOICE=
# Optional: a free TTS model to prefer while the catalogue lists it. Only IDs
# ending in ":free" are accepted.
OPENROUTER_TTS_MODEL=

# --- Site ------------------------------------------------------------------
# Canonical origin, used for Open Graph tags and the sitemap.
# Safe to leave blank: on Vercel the deployment host is used automatically,
# and locally it falls back to http://localhost:3000. A bare host such as
# `archit.ai` works too — the scheme is added for you.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Search consoles (optional) ---------------------------------------------
# Ownership tokens for Google Search Console and Bing Webmaster Tools, using
# their "HTML tag" method. Paste only the token: the value inside content="…".
# Needs a redeploy after setting; the tags are left out while these are blank.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# --- Enquiry alerts (optional) ----------------------------------------------
# Enquiries from /work-with-me are always saved to the Supabase `leads` table.
# Set RESEND_API_KEY (free at resend.com) to also get each one by email, with
# the sender as reply-to. With no domain set up, Resend sends from
# onboarding@resend.dev to the address the Resend account was created with.
RESEND_API_KEY=
# Where alerts go (defaults to the email in content/profile.ts).
LEAD_NOTIFY_EMAIL=
