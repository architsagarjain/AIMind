# ---------------------------------------------------------------------------
# ARCHIT.AI environment
# Copy to `.env.local` for local dev. Every value below is OPTIONAL — the site
# renders and the chat falls back to a deterministic local responder when the
# keys are absent, so nothing hard-fails in a fresh clone.
# ---------------------------------------------------------------------------

# --- OpenRouter (powers the "Ask Archit" clone, FREE models only) -----------
# Server-only. Without it the chat answers from the pre-written responder.
OPENROUTER_API_KEY=
# Optional: comma-separated preference order. Only IDs ending in ":free" are
# accepted; anything else is ignored, so this cannot enable a paid model. Each
# is also checked against OpenRouter's live catalogue for zero pricing.
OPENROUTER_MODELS=

# --- Supabase (chat persistence + analytics) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# --- ElevenLabs (read-aloud voice in the chat) ------------------------------
# Optional. Without it the "Listen" control is hidden entirely rather than
# failing — /api/speak answers 503 and the UI removes the button.
ELEVENLABS_API_KEY=
# Optional. Leave blank and the route resolves a male voice by name from the
# account's own library, which avoids depending on an ID that may not exist.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5

# --- Site ------------------------------------------------------------------
# Canonical origin, used for Open Graph tags and the sitemap.
# Safe to leave blank: on Vercel the deployment host is used automatically,
# and locally it falls back to http://localhost:3000. A bare host such as
# `archit.ai` works too — the scheme is added for you.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
